# ==========================================
# Server & CORS Configuration
# ==========================================
PORT=4000
# Frontend Client URL allowed to make cross-origin requests (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# ==========================================
# MongoDB Database Connection
# ==========================================
# Local MongoDB example:
MONGO_URL=mongodb://localhost:27017/demand_forecast
# MongoDB Atlas (Cloud) example:
# MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/demand_forecast?retryWrites=true&w=majority

# ==========================================
# Authentication & Security
# ==========================================
# Secret key used for signing and verifying JWT tokens (use a strong random string)
TOKEN_KEY=your_jwt_secret_token_key_change_in_production

# ==========================================
# ML Service Integration
# ==========================================
# Base URL of the Python FastAPI ML microservice
ML_SERVICE_URL=http://localhost:8000

# Shared secret key between Node server and ML service (must match ML_SERVICE_KEY in ml-service/.env)
ML_SERVICE_KEY=your_shared_ml_service_secret_key
