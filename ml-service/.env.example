# ==========================================
# Node Backend API Connection
# ==========================================
# URL of the Node.js Express server to fetch datasets from
NODE_API_URL=http://localhost:4000

# ==========================================
# Authentication & Security
# ==========================================
# Shared secret key matching ML_SERVICE_KEY in server/.env
ML_SERVICE_KEY=your_shared_ml_service_secret_key

# ==========================================
# Model Storage (Optional)
# ==========================================
# Path where trained model files and metadata will be stored (defaults to /tmp/demandforecast_models if unset)
MODEL_DIR=./models
